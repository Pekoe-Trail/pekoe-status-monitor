---
import Base from '../layouts/Base.astro';
import AlertCard from '../components/AlertCard.astro';
import AlertRows from '../components/AlertRows.astro';
import IncidentList from '../components/IncidentList.astro';
import StageStrip from '../components/StageStrip.astro';
import StatusBoard from '../components/StatusBoard.astro';
import SystemCard from '../components/SystemCard.astro';
import { current as currentAlerts, hasAlerts, past as pastAlerts } from '../lib/alerts.ts';
import { active, recentPast, upcoming } from '../lib/incidents.ts';
import { groups, isStale, updatedAt, formatDateTime } from '../lib/status.ts';

const past = recentPast(14);
const recentlyResolved = pastAlerts.slice(0, 3);
---

<Base>
  <h1 class="visually-hidden">Pekoe Trail status</h1>
  <StatusBoard />
  {
    isStale && updatedAt && (
      <p class="notice">
        Checks are running late. The last check was at {formatDateTime(updatedAt)}, Sri Lanka time, so
        this page may be out of date.
      </p>
    )
  }

  <section id="trail" class="zone">
    <div class="zone-head">
      <div>
        <p class="eyebrow">Trail</p>
        <h2>Conditions on the trail</h2>
      </div>
      <a class="zone-link" href="/alerts/">All trail alerts →</a>
    </div>

    {
      !hasAlerts ? (
        <div class="card">
          <p class="empty">Trail alerts aren't available yet.</p>
        </div>
      ) : (
        <>
          <StageStrip />
          {currentAlerts.length > 0 ? (
            <div class="alert-grid">
              {currentAlerts.map((alert) => <AlertCard alert={alert} />)}
            </div>
          ) : (
            <div class="card">
              <p class="empty">No active trail alerts. All stages are open.</p>
            </div>
          )}
          {recentlyResolved.length > 0 && (
            <>
              <h3 class="zone-sub">Recently resolved</h3>
              <AlertRows items={recentlyResolved} />
            </>
          )}
        </>
      )
    }
  </section>

  <section id="digital" class="zone">
    <div class="zone-head">
      <div>
        <p class="eyebrow">Digital</p>
        <h2>Website, app and services</h2>
      </div>
      <a class="zone-link" href="/incidents/">All incidents →</a>
    </div>

    {
      active.length > 0 && (
        <>
          <h3 class="zone-sub">Happening now</h3>
          <IncidentList items={active} />
        </>
      )
    }

    {
      upcoming.length > 0 && (
        <>
          <h3 class="zone-sub">Planned maintenance</h3>
          <IncidentList items={upcoming} />
        </>
      )
    }

    {
      groups.map(([group, members]) => (
        <>
          <h3 class="zone-sub">{group}</h3>
          <div class="system-grid">
            {members.map((system) => <SystemCard system={system} />)}
          </div>
        </>
      ))
    }

    <h3 class="zone-sub">Past 14 days</h3>
    <IncidentList items={past} empty="No incidents in the past 14 days." />
  </section>
</Base>
