---
import Base from '../layouts/Base.astro';
import StageGrid from '../components/StageGrid.astro';
import StageLanes from '../components/StageLanes.astro';
import StatusBoard from '../components/StatusBoard.astro';
import { alerts, alertsUpdatedAt, hasAlerts, severityClass, stages } from '../lib/alerts.ts';
import { incidentStories, storiesBetween } from '../lib/lifecycle.ts';
import { formatDateTime } from '../lib/status.ts';
import { YEAR_DAYS } from '../lib/year.ts';
import { addDays, localDay } from '../../scripts/lib/time.ts';

const LEGEND = { OK: 'Open', ADVISORY: 'Advisory', PRECAUTION: 'Precaution', CLOSED: 'Closed' } as const;
const to = localDay(new Date());
const from = addDays(to, 1 - YEAR_DAYS);
const now = Date.now();
const year = storiesBetween(incidentStories(alerts, null), Date.parse(`${from}T00:00:00+05:30`), now);
---

<Base
  section="trail"
  description="Live conditions on the Pekoe Trail: which stages are open, and the incidents and alerts in force now."
>
  <h1 class="visually-hidden">Pekoe Trail conditions</h1>
  <StatusBoard show="trail" />

  {
    !hasAlerts ? (
      <section class="zone">
        <div class="card">
          <p class="empty">Trail alerts aren't available yet.</p>
        </div>
      </section>
    ) : (
      <>
        <section class="zone" aria-labelledby="stages-title">
          <div class="zone-head">
            <div>
              <p class="eyebrow">Stages</p>
              <h2 id="stages-title">All {stages.length} stages</h2>
            </div>
          </div>
          <ul class="stages-legend grid-legend" aria-label="Stage colours">
            {Object.entries(LEGEND).map(([sev, label]) => (
              <li><span class:list={['swatch', severityClass(sev as keyof typeof LEGEND)]} />{label}</li>
            ))}
          </ul>
          <StageGrid />
        </section>

        {year.length > 0 && (
          <section class="zone" aria-labelledby="timeline-title">
            <div class="zone-head">
              <div>
                <p class="eyebrow">Timeline</p>
                <h2 id="timeline-title">Past year by stage</h2>
              </div>
            </div>
            <div class="card lanes-card">
              <p class="lanes-note">One row per stage, in its colour at the time. Each dot is an alert; select one to read it.</p>
              <StageLanes from={from} to={to} now={now} />
            </div>
          </section>
        )}

        <p class="small muted">
          {alertsUpdatedAt && <>Last updated {formatDateTime(alertsUpdatedAt)}, Sri Lanka time. </>}
          Maps and stage details from <a href="https://thepekoetrail.org/pekoe-stages/">thepekoetrail.org</a>.
        </p>
      </>
    )
  }
</Base>
