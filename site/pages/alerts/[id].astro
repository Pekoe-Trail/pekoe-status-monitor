---
import Base from '../../layouts/Base.astro';
import ChannelPills from '../../components/ChannelPills.astro';
import {
  alertHref,
  alertTitle,
  alerts,
  current,
  severityClass,
  where,
  type Alert,
} from '../../lib/alerts.ts';
import { formatDateTime } from '../../lib/status.ts';

/**
 * Lists one page per trail alert, named after its lower-cased number.
 *
 * @returns Each alert's route, such as `tpto-psa-00000042`, with the alert as the page's props.
 */
export function getStaticPaths() {
  return alerts.map((alert) => ({ params: { id: alert.number.toLowerCase() }, props: { alert } }));
}

interface Props {
  alert: Alert;
}

const { alert } = Astro.props;
const title = alertTitle(alert);
const showing = current.includes(alert);
const sev = severityClass(alert.severity.value);
const later = alerts
  .filter(
    (other) =>
      Date.parse(other.publishedAt) > Date.parse(alert.publishedAt) &&
      other.stages.some((s) => alert.stages.some((mine) => mine.number === s.number)),
  )
  .sort((a, b) => Date.parse(a.publishedAt) - Date.parse(b.publishedAt));
const replacedBy = showing
  ? undefined
  : (later.find((other) => other.incident.id === alert.incident.id) ?? later[0]);
---

<Base section="trail" title={title} description={`${alert.severity.label}, ${where(alert)}: ${title}`}>
  <a class="back" href="/trail">← Trail</a>

  <div class:list={['alert-hero', sev, { done: !showing }]}>
    <div class="alert-card-top">
      <span class:list={['sev', sev]}>{alert.severity.label}</span>
      {showing ? <span class="tag">Showing now</span> : <span class="tag">Replaced</span>}
      <span class="alert-where">{alert.number}</span>
    </div>
    <h1>{title}</h1>
    <dl class="alert-facts">
      <div><dt>Where</dt><dd>{where(alert)}</dd></div>
      <div><dt>Category</dt><dd>{alert.category.label}</dd></div>
      <div><dt>Incident</dt><dd>{alert.incident.number}: {alert.incident.description}</dd></div>
      {
        alert.channels.length > 0 && (
          <div>
            <dt>Alert sent via</dt>
            <dd><ChannelPills channels={alert.channels} heading={false} /></dd>
          </div>
        )
      }
      <div><dt>Published</dt><dd>{formatDateTime(new Date(alert.publishedAt))}</dd></div>
      {
        replacedBy && (
          <div>
            <dt>Replaced</dt>
            <dd>{formatDateTime(new Date(replacedBy.publishedAt))}</dd>
          </div>
        )
      }
    </dl>
  </div>

  <div class="card prose">
    {alert.impact && (<><h2>What's happening</h2><p>{alert.impact}</p></>)}
    {alert.action && (<><h2>What to do</h2><p>{alert.action}</p></>)}
    {
      alert.links.map((link) => (
        <p>
          <a class="button" href={link.url} rel="noopener noreferrer">{link.label ?? 'Learn more'} →</a>
        </p>
      ))
    }
  </div>

  {
    replacedBy && (
      <p class="small muted">
        Replaced by{' '}
        <a href={alertHref(replacedBy)}>
          {replacedBy.number}: {alertTitle(replacedBy)}
        </a>.
      </p>
    )
  }
  <p class="small muted">Times are Sri Lanka time.</p>
</Base>
