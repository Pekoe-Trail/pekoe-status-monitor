---
import Base from '../../layouts/Base.astro';
import AlertLinks from '../../components/AlertLinks.astro';
import ChannelPills from '../../components/ChannelPills.astro';
import StageNav from '../../components/StageNav.astro';
import StatusIcon from '../../components/StatusIcon.astro';
import {
  alertTitle,
  alerts,
  current,
  severityClass,
  stageHref,
  stagesLabel,
  where,
  type Alert,
} from '../../lib/alerts.ts';
import { SEVERITY_ICON } from '../../lib/icons.ts';
import { formatDateTime } from '../../lib/status.ts';

/**
 * Lists one page per trail alert, named after its lower-cased number.
 *
 * @returns Each alert's route, such as `tpto-psa-00000042`, with the alert as the page's props.
 */
export function getStaticPaths() {
  return alerts.map((alert) => ({ params: { id: alert.number.toLowerCase() }, props: { alert } }));
}

interface Props {
  alert: Alert;
}

const { alert } = Astro.props;
const title = alertTitle(alert);
const showing = current.includes(alert);
const sev = severityClass(alert.severity.value);
const later = alerts
  .filter(
    (other) =>
      Date.parse(other.publishedAt) > Date.parse(alert.publishedAt) &&
      other.stages.some((s) => alert.stages.some((mine) => mine.number === s.number)),
  )
  .sort((a, b) => Date.parse(a.publishedAt) - Date.parse(b.publishedAt));
const replacedBy = showing
  ? undefined
  : (later.find((other) => other.incident.id === alert.incident.id) ?? later[0]);
const numbers = alert.stages.map((s) => s.number).sort((a, b) => a - b);
const everyStage = stagesLabel(numbers) === 'All stages';
const badge =
  numbers.length === 1
    ? { label: 'Stage', value: String(numbers[0]).padStart(2, '0') }
    : { label: 'Stages', value: everyStage ? 'All' : String(numbers.length) };
---

<Base section="trail" title={title} description={`${alert.severity.label}, ${where(alert)}: ${title}`}>
  <a class="back" href="/">← Trail</a>

  <header class:list={['board-card', 'board-trail', 'alert-head', sev]}>
    <div class="alert-stage">
      <span class="alert-stage-label" data-stage-badge-label>{badge.label}</span>
      <span class="alert-stage-num" data-stage-badge-num>{badge.value}</span>
    </div>
    <span class="board-label">
      <StatusIcon path={SEVERITY_ICON[alert.severity.value]} />
      {alert.severity.label} · {alert.number}
    </span>
    <h1 class="board-headline">{title}</h1>
    <p class="alert-head-meta">
      {
        showing ? (
          <span class="alert-state is-showing">
            <span class="story-live-dot" aria-hidden="true" />
            Showing now
          </span>
        ) : (
          <span class="alert-state">Replaced</span>
        )
      }
      <span>Published {formatDateTime(new Date(alert.publishedAt))}</span>
    </p>
  </header>

  <StageNav alert={alert} stages={numbers} />

  <div class="alert-layout">
    <div class="alert-main">
      {
        alert.impact && (
          <section class="card alert-section">
            <h2>What's happening</h2>
            <p>{alert.impact}</p>
            <AlertLinks links={alert.links} />
          </section>
        )
      }
      {
        alert.action && (
          <section class:list={['card', 'alert-section', 'alert-action', sev]}>
            <h2>
              <StatusIcon path={SEVERITY_ICON[alert.severity.value]} />
              What to do
            </h2>
            <p>{alert.action}</p>
          </section>
        )
      }
      {!alert.impact && <AlertLinks links={alert.links} />}
    </div>

    <aside class="card alert-details" aria-labelledby="details-title">
      <h2 id="details-title">Details</h2>
      <dl>
        <div>
          <dt data-stage-label>{numbers.length === 1 ? 'Stage' : 'Stages'}</dt>
          <dd>
            {everyStage && <span data-all-stages>All stages</span>}
            <ul class="stage-chips" hidden={everyStage}>
              {numbers.map((n) => (
                <li data-stage={n}><a href={stageHref(n)} title={`Stage ${n}`}>{n}</a></li>
              ))}
            </ul>
            <span class="alert-details-sub" data-other-stages hidden />
          </dd>
        </div>
        <div><dt>Category</dt><dd>{alert.category.label}</dd></div>
        <div>
          <dt>Incident</dt>
          <dd>{alert.incident.description}<span class="alert-details-sub">{alert.incident.number}</span></dd>
        </div>
        <div><dt>Published</dt><dd>{formatDateTime(new Date(alert.publishedAt))}</dd></div>
        {
          replacedBy && (
            <div>
              <dt>Replaced</dt>
              <dd>{formatDateTime(new Date(replacedBy.publishedAt))}</dd>
            </div>
          )
        }
        {
          alert.channels.length > 0 && (
            <div>
              <dt>Sent via</dt>
              <dd><ChannelPills channels={alert.channels} heading={false} /></dd>
            </div>
          )
        }
      </dl>
    </aside>
  </div>

  <p class="small muted">Times are Sri Lanka time.</p>
</Base>
