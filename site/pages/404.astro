---
import Base from '../layouts/Base.astro';
---

<Base section="system" title="Page not found" description="This page doesn't exist on the Pekoe Trail status site.">
  <div class="lost">
    <img class="logo-light" src="/logo.png" width="180" height="119" alt="The Pekoe Trail" />
    <img class="logo-dark" src="/logo-white.png" width="180" height="119" alt="The Pekoe Trail" />
    <p class="lost-code">404</p>
    <h1>This path isn't on the map</h1>
    <p class="muted">The page you asked for doesn't exist, or it has moved.</p>
    <div class="lost-links">
      <a class="button" href="/trail">Trail conditions</a>
      <a class="button button-quiet" href="/system">Website, app and services</a>
    </div>
  </div>
</Base>
