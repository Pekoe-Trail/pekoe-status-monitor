---
import ChannelPills from './ChannelPills.astro';
import YearLinks from './YearLinks.astro';
import YearMap from './YearMap.astro';
import {
  alertAnchor,
  alertHref,
  alertTitle,
  firstRecordDay,
  severityClass,
  stageAlerts,
  stageTimeline,
  where,
} from '../lib/alerts.ts';
import { days, stageDays } from '../lib/calendar.ts';
import { formatDateTime } from '../lib/status.ts';

interface Props {
  /** The stage number, or null for the whole trail. */
  stage: number | null;
  /** The page the year links belong to, such as `/stages/4` or `/stages/overall`. */
  base: string;
  /** The first day shown, as `YYYY-MM-DD`. */
  from: string;
  /** The last day shown, as `YYYY-MM-DD`. */
  to: string;
  /** What the map covers, such as "Stage 4 in 2025". */
  label: string;
  /** The year being shown, or 'recent' for the rolling window, for the year links. */
  current: string;
}

const { stage, base, from, to, label, current } = Astro.props;
const colours = stageDays(stageAlerts(stage), days(from, to), stage);
const published = stageTimeline(stage, from, to);
const marks = published.map((alert) => ({ at: Date.parse(alert.publishedAt), anchor: alertAnchor(alert) }));
---

<YearLinks base={base} current={current} />
<YearMap colours={colours} from={from} to={to} label={label} marks={marks} since={firstRecordDay} />

<h3 class="zone-sub">Timeline</h3>
{
  published.length === 0 ? (
    <div class="card">
      <p class="empty">
        No alerts {stage === null ? 'on the trail' : 'on this stage'}{' '}
        {current === 'recent' ? 'in the past year' : `in ${current}`}.
      </p>
    </div>
  ) : (
    <ol class="timeline card">
      {published.map((alert) => (
        <li
          id={alertAnchor(alert)}
          class:list={[severityClass(alert.severity.value), { done: alert.severity.value === 'OK' }]}
        >
          <div class="timeline-head">
            <span class:list={['sev', 'sev-small', severityClass(alert.severity.value)]}>{alert.severity.label}</span>
            <time class="timeline-when" datetime={alert.publishedAt}>{formatDateTime(new Date(alert.publishedAt))}</time>
          </div>
          <div class="timeline-alert">
            <a href={alertHref(alert)}>{alert.number}: {alertTitle(alert)}</a>
            <span class="muted"> · {where(alert)}</span>
          </div>
          {alert.impact && <p>{alert.impact}</p>}
          <ChannelPills channels={alert.channels} />
        </li>
      ))}
    </ol>
  )
}
<p class="small muted">Times are Sri Lanka time.</p>
