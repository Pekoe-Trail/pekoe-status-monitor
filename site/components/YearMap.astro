---
import { severityClass, type Severity } from '../lib/alerts.ts';
import type { DayColour } from '../lib/calendar.ts';
import { formatDate } from '../lib/status.ts';
import { yearWeeks, type YearCell, type YearMark } from '../lib/year.ts';

interface Props {
  /** The stage's days that ended with an alert open. */
  colours: DayColour[];
  /** The first day shown, as `YYYY-MM-DD`. */
  from: string;
  /** The last day shown, as `YYYY-MM-DD`. */
  to: string;
  /** What the map covers, for its screen-reader summary, such as "Stage 4 in 2025". */
  label: string;
  /** The page's timeline entries, so a day links to the one that set its colour. */
  marks?: YearMark[];
  since: string | null;
}

const { colours, from, to, label, marks = [], since } = Astro.props;
const LABEL: Record<Severity, string> = { OK: 'Open', ADVISORY: 'Advisory', PRECAUTION: 'Precaution', CLOSED: 'Closed' };
const weeks = yearWeeks(colours, from, to, marks, since);
const cells = weeks.flatMap((week) => week.days).filter((cell): cell is YearCell => cell !== null);
const count = (severity: Severity | null) => cells.filter((cell) => cell.severity === severity).length;
const withAlerts = cells.filter((cell) => cell.severity !== null && cell.severity !== 'OK').length;
const unrecorded = count(null);

/**
 * Writes the tooltip for one day.
 *
 * @param cell The day.
 * @returns The date, the stage's colour at the end of it or that there are no records, and
 *   the alerts open then.
 */
function describe(cell: YearCell) {
  const parts = [formatDate(cell.day), cell.severity === null ? 'No records' : LABEL[cell.severity]];
  if (cell.alerts.length > 0) parts.push(cell.alerts.join(', '));
  return parts.join(' · ');
}

/**
 * Names the CSS class for one day.
 *
 * @param cell The day.
 * @returns Its severity's class, or `sev-none` when it has no records.
 */
const cellClass = (cell: YearCell) => (cell.severity === null ? 'sev-none' : severityClass(cell.severity));
---

<div class="card year">
  <div class="year-scroll">
    <div
      class="year-map"
      role="img"
      aria-label={`${label}: ${count('OK')} days open, ${count('ADVISORY')} with an advisory, ${count('PRECAUTION')} with a precaution, ${count('CLOSED')} closed${unrecorded > 0 ? `, ${unrecorded} with no records` : ''}`}
    >
      <div class="year-months" aria-hidden="true">
        {weeks.map((week) => <span>{week.month}</span>)}
      </div>
      <div class="year-days" aria-hidden="true">
        <span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span>
      </div>
      <div class="year-grid">
        {
          weeks.flatMap((week) =>
            week.days.map((cell) =>
              cell === null ? (
                <span class="pad" />
              ) : cell.anchor ? (
                <a class={cellClass(cell)} href={`#${cell.anchor}`} data-tip={describe(cell)} tabindex="-1" />
              ) : (
                <span class={cellClass(cell)} data-tip={describe(cell)} />
              ),
            ),
          )
        }
      </div>
    </div>
  </div>
  <div class="year-foot">
    <span>
      {unrecorded === cells.length
        ? 'No records yet'
        : withAlerts > 0
          ? `${withAlerts} days with an alert`
          : unrecorded > 0
            ? 'Open every day on record'
            : 'Open every day shown'}
    </span>
    <ul class="stages-legend" aria-hidden="true">
      {Object.entries(LABEL).map(([sev, text]) => (
        <li><span class:list={['swatch', severityClass(sev as Severity)]} />{text}</li>
      ))}
      <li><span class="swatch sev-none" />No records</li>
    </ul>
  </div>
</div>
