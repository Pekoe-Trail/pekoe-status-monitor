---
import { alertTitle, severityClass, stageHref, stages } from '../lib/alerts.ts';
import { stageInfo, stageMap } from '../lib/stage-info.ts';

const LABEL = { OK: 'Open', ADVISORY: 'Advisory', PRECAUTION: 'Precaution', CLOSED: 'Closed' } as const;
/**
 * Writes a stage number with two digits, as the website's stage cards do.
 *
 * @param n The stage number.
 * @returns The number, such as `05`.
 */
const pad = (n: number) => String(n).padStart(2, '0');
---

{
  stages.length > 0 && (
    <ol class="stage-grid">
      {stages.map((stage) => {
        const info = stageInfo(stage.number);
        const sev = severityClass(stage.severity);
        return (
          <li>
            <a class:list={['stage-card', sev]} href={stageHref(stage.number)}>
              <span class="stage-card-top">
                <span class="stage-card-num" aria-hidden="true">{pad(stage.number)}</span>
                <span class:list={['stage-pill', sev]}>
                  <span class="stage-pill-dot" aria-hidden="true" />
                  {LABEL[stage.severity]}
                </span>
              </span>
              <span class="stage-card-map">
                <img src={stageMap(stage.number)} width="480" height="501" alt="" loading="lazy" decoding="async" />
              </span>
              <span class="stage-card-body">
                <span class="stage-card-eyebrow">Stage {stage.number}</span>
                <span class="stage-card-name">
                  {info ? (
                    <>
                      {info.from} <span class="stage-card-arrow" aria-label="to">⇌</span> {info.to}
                    </>
                  ) : (
                    `Stage ${stage.number}`
                  )}
                </span>
                {stage.alert && stage.severity !== 'OK' && (
                  <span class="stage-card-alert">{alertTitle(stage.alert)}</span>
                )}
                {info?.specialHours && <span class="stage-card-note">Special trail hours</span>}
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  )
}
