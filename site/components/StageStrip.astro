---
import { severityClass, stages, trail } from '../lib/alerts.ts';

const LABEL = { OK: 'Open', ADVISORY: 'Advisory', PRECAUTION: 'Precaution', CLOSED: 'Closed' } as const;
const overall = trail.severity === 'unknown' ? 'sev-unknown' : severityClass(trail.severity);
---

{
  stages.length > 0 && (
    <div class="card stages">
      <div class="stages-head">
        <span class="stages-title">Stages</span>
        <ul class="stages-legend" aria-hidden="true">
          {Object.entries(LABEL).map(([sev, label]) => (
            <li><span class:list={['swatch', severityClass(sev as keyof typeof LABEL)]} />{label}</li>
          ))}
        </ul>
      </div>
      <a class:list={['stage-all', overall]} href="/stages/overall">
        <span class="stage-all-name">All stages</span>
        <span class="stage-all-note">Every alert on the trail</span>
      </a>
      <ol class="stage-strip">
        {stages.map((stage) => {
          const label = `Stage ${stage.number}: ${LABEL[stage.severity]}${stage.alert ? `, ${stage.alert.title ?? stage.alert.category.label}` : ''}`;
          return (
            <li>
              <a class:list={['stage', severityClass(stage.severity)]} href={`/stages/${stage.number}`} data-tip={label} aria-label={label}>
                {stage.number}
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  )
}
