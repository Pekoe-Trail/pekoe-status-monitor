---
import '../styles/global.css';
import { formatDateTime, updatedAt } from '../lib/status.ts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Live status of the Pekoe Trail website, app and services, with uptime history and incident reports.' } = Astro.props;
const pageTitle = title ? `${title} · Pekoe Trail Status` : 'Pekoe Trail Status';
const path = Astro.url.pathname;
/**
 * Marks the nav link for the page being shown.
 *
 * @param href The link's path.
 * @returns `page` when the current path is that section (exactly `/` for the home link),
 *   for `aria-current`; otherwise undefined.
 */
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && (
      <meta
        http-equiv="Content-Security-Policy"
        content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'"
      />
    )}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light" />
    <script is:inline src="/theme.js"></script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Pekoe Trail incidents" href="/incidents/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <img class="logo-light" src="/logo.png" width="72" height="48" alt="The Pekoe Trail" />
          <img class="logo-dark" src="/logo-white.png" width="72" height="48" alt="The Pekoe Trail" />
          <span class="brand-label">Status</span>
        </a>
        <div class="header-end">
          <nav class="site-nav" aria-label="Main">
            <a href="/" aria-current={current('/')}>Status</a>
            <a href="/alerts/" aria-current={current('/alerts/')}>Trail alerts</a>
            <a href="/incidents/" aria-current={current('/incidents/')}>Incidents</a>
          </nav>
          <button class="theme-toggle" type="button" aria-label="Switch theme" hidden>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>
          {updatedAt ? <>Last checked {formatDateTime(updatedAt)}, Sri Lanka time</> : 'No checks yet'}
        </span>
        <span>
          <a href="https://thepekoetrail.org">thepekoetrail.org</a>{' · '}
          <a href="/incidents/rss.xml">RSS</a>{' · '}
          <a href="/status.json">status.json</a>
        </span>
      </div>
    </footer>
  </body>
</html>
